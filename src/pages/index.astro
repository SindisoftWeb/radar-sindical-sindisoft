---
import BaseLayout from '../layouts/BaseLayout.astro';
const modules = import.meta.glob('./artigos/*.md', { eager: true });
const posts = Object.values(modules).map((entry: any) => ({ ...entry.frontmatter, url: entry.url }))
  .sort((a: any, b: any) => String(b.date).localeCompare(String(a.date)));
const editorias = ['Gestão sindical', 'Convenções coletivas', 'Tecnologia e processos', 'Comunicação com a categoria'];
const accent = ['01', '02', '03', '04'];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="pill"><span class="pulse"></span> CONHECIMENTO PARA QUEM REPRESENTA</div>
        <h1>Informação que <em>fortalece</em> a gestão sindical.</h1>
        <p>Notícias relevantes, análises e guias práticos para sindicatos, federações, confederações e associações de classe.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#conteudos">Explorar conteúdos <span aria-hidden="true">↗</span></a>
          <a class="simple-link" href="#sobre">Conheça o Radar <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="radar-circle outer"></div><div class="radar-circle middle"></div><div class="radar-circle inner"></div>
        <div class="radar-sweep"></div><div class="radar-point point-one"></div><div class="radar-point point-two"></div><div class="radar-point point-three"></div>
        <div class="hero-art-caption"><span>RADAR SINDICAL</span><strong>Conectar informação<br/>e decisão.</strong></div>
      </div>
    </div>
  </section>
  <section class="editorias-section" id="editorias">
    <div class="container">
      <div class="section-header"><div><span class="eyebrow">NOSSO OLHAR</span><h2>Assuntos que fazem a diferença</h2></div><p>Conhecimento útil para a rotina de quem lidera e administra entidades de classe.</p></div>
      <div class="editorias-grid">
        {editorias.map((nome, i) => <a href="#conteudos" class="editoria-card"><span class="editoria-number">{accent[i]}</span><h3>{nome}</h3><span class="editoria-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>
  <section class="conteudos-section" id="conteudos">
    <div class="container">
      <div class="section-header"><div><span class="eyebrow">BIBLIOTECA DO RADAR</span><h2>Conteúdos para sua entidade</h2></div><p>Informações e orientações para apoiar uma gestão organizada e conectada às necessidades da categoria.</p></div>
      <div class="filters">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Busque um assunto..." aria-label="Buscar artigos" /></label>
        <span id="count" class="result-count">{posts.length} conteúdos</span>
      </div>
      <div class="posts-grid" id="posts-grid">
        {posts.map((post: any, i: number) =>
          <a class="post-card" href={post.url} data-search={(post.title + ' ' + post.description + ' ' + post.category).toLowerCase()}>
            <div class={'post-visual visual-' + (i % 3 + 1)}>
              <span class="visual-label">RADAR / {String(i + 1).padStart(2, '0')}</span>
              <span class="visual-icon" aria-hidden="true">{['◈', '◎', '◇'][i % 3]}</span>
              <span class="visual-word">SINDISOFT</span>
            </div>
            <div class="post-content">
              <span class="post-category">{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <span class="post-foot"><span>{post.readingTime || 'Leitura breve'}</span><span class="read-more">Ler artigo →</span></span>
            </div>
          </a>
        )}
      </div>
      <p id="empty-state" class="empty-state" hidden>Nenhum artigo encontrado. Experimente outro termo.</p>
    </div>
  </section>
  <section class="about-section" id="sobre"><div class="container about-grid"><div><span class="eyebrow light">NOSSO PROPÓSITO</span><h2>Gestão sindical mais forte começa com boas informações.</h2></div><div><p>O Radar Sindical é uma iniciativa editorial da Sindisoft, dedicada a compartilhar conhecimento aplicável à realidade das entidades de classe.</p><p>Unimos informação, gestão e tecnologia para apoiar decisões e fortalecer processos.</p><a class="button button-outline" href="https://sindisoft.com.br/" target="_blank" rel="noopener noreferrer">Conhecer a Sindisoft ↗</a></div></div></section>
  <script is:inline>
    (() => {
      const search = document.getElementById('search');
      const cards = Array.from(document.querySelectorAll('.post-card'));
      const counter = document.getElementById('count');
      const empty = document.getElementById('empty-state');
      if (!search) return;
      search.addEventListener('input', () => {
        const query = search.value.trim().toLocaleLowerCase('pt-BR');
        let visible = 0;
        cards.forEach(card => {
          const show = card.dataset.search.includes(query);
          card.hidden = !show;
          if (show) visible++;
        });
        counter.textContent = visible + (visible === 1 ? ' conteúdo' : ' conteúdos');
        empty.hidden = visible !== 0;
      });
    })();
  </script>
</BaseLayout>
