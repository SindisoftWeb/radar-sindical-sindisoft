---
import BaseLayout from '../layouts/BaseLayout.astro';
const classify = (item: any) => {
  const cat = String(item.category || '').toLocaleLowerCase('pt-BR');
  if (cat.includes('sindisoft na prática') || cat.includes('sindisoft na pratica')) return 'sindisoft';
  if (item.sourcePublishedAt || cat.startsWith('notícia') || cat.startsWith('noticia')) return 'noticias';
  if (cat.includes('tecnologia') || cat.includes('transformação digital')) return 'tecnologia';
  return 'gestao';
};
const modules = import.meta.glob('./artigos/*.md', { eager: true });
const posts = Object.values(modules)
  .map((entry: any) => ({ ...entry.frontmatter, url: entry.url, editoria: classify(entry.frontmatter) }))
  .sort((a: any, b: any) => String(b.date).localeCompare(String(a.date)));
const featured = posts[0];
const formatDateTime = (value: any) => new Date(value).toLocaleString('pt-BR', {
  day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo'
});
const editorias = [
  { id: 'noticias', name: 'Notícias sindicais', desc: 'Fatos verificados, decisões e mudanças relevantes para entidades.' },
  { id: 'gestao', name: 'Gestão sindical', desc: 'Organização, arrecadação, atendimento e boas práticas.' },
  { id: 'tecnologia', name: 'Tecnologia para sindicatos', desc: 'Processos digitais, dados e continuidade operacional.' },
  { id: 'sindisoft', name: 'Sindisoft na prática', desc: 'Aplicações e recursos comprovados da plataforma.' }
];
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-grid-pattern" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="pill">SINDISOFT / INTELIGÊNCIA SINDICAL</p>
        <h1 id="hero-heading">Informação, gestão e tecnologia <em>para entidades.</em></h1>
        <p>Notícias verificadas, boas práticas de gestão e conteúdos sobre tecnologia aplicada à rotina de sindicatos, federações e entidades de classe.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#conteudos">Explorar conteúdos <span aria-hidden="true">→</span></a>
          <a class="simple-link" href="#sobre">Conheça o Radar <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-footnote">Conteúdo para quem representa, administra e toma decisões.</p>
      </div>
      {featured && (
        <div class="hero-feature">
          <div class="feature-topbar">
            <span class="feature-topbar-left"><span class="feature-dot"></span> RADAR SINDICAL</span>
            <span class="feature-topbar-right">SINDISOFT / EDITORIAL</span>
          </div>
          <div class="feature-inner">
            {featured.image && <div class="feature-image-wrap"><img class="feature-image" src={featured.image} alt={featured.imageAlt || featured.title} loading="eager" decoding="async" onerror="this.parentElement.remove()" /></div>}
            <p class="feature-eyebrow">CONTEÚDO EM DESTAQUE</p>
            <h2>{featured.title}</h2>
            <p>{featured.description}</p>
            <a href={featured.url} class="feature-link">Ler artigo completo <span aria-hidden="true">↗</span></a>
          </div>
          <div class="feature-bottom">
            <span>{featured.category}</span><span>Conhecimento em movimento ↗</span>
          </div>
        </div>
      )}
    </div>
    <div class="hero-scope">
      <div class="container">
        <span>Conhecimento para a rotina da sua entidade</span>
        <a href="/?categoria=noticias#conteudos">Notícias sindicais</a>
        <a href="/?categoria=gestao#conteudos">Gestão sindical</a>
        <a href="/?categoria=tecnologia#conteudos">Tecnologia</a>
        <a href="/?categoria=sindisoft#conteudos">Sindisoft na prática</a>
      </div>
    </div>
  </section>

  <section class="editorias-section" id="editorias">
    <div class="container">
      <div class="section-header">
        <div><span class="eyebrow">OS ASSUNTOS DO RADAR</span><h2>Conhecimento que acompanha a sua operação.</h2></div>
        <p>Um olhar sobre as decisões, os desafios e as oportunidades de quem trabalha com a representação de uma categoria.</p>
      </div>
      <div class="editorias-grid">
        {editorias.map((item, i) =>
          <a href={'/?categoria=' + item.id + '#conteudos'} class="editoria-card">
            <span class="editoria-number">{String(i + 1).padStart(2, '0')}</span>
            <div class="editoria-detail"><h3>{item.name}</h3><p>{item.desc}</p></div>
            <span class="editoria-arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="conteudos-section" id="conteudos">
    <div class="container">
      <div class="section-header">
        <div><span class="eyebrow">BIBLIOTECA DE CONTEÚDOS</span><h2>Explore o Radar Sindical.</h2></div>
        <p>Artigos e orientações para apoiar uma gestão cada vez mais organizada, eficiente e conectada.</p>
      </div>
      <div class="category-filters" role="group" aria-label="Filtrar por editoria">
        <button type="button" class="category-filter active" data-editoria-filter="todos" aria-pressed="true">Todos</button>
        {editorias.map(item => <button type="button" class="category-filter" data-editoria-filter={item.id} aria-pressed="false">{item.name}</button>)}
      </div>
      <div class="filters">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Buscar por assunto ou palavra-chave..." aria-label="Buscar artigos" /></label>
        <span id="count" class="result-count">{posts.length} conteúdos</span>
      </div>
      <div class="posts-grid" id="posts-grid">
        {posts.map((post: any, i: number) =>
          <a class="post-card" href={post.url} data-editoria={post.editoria} data-search={(post.title + ' ' + post.description + ' ' + post.category).toLocaleLowerCase('pt-BR')}>
            <div class={'post-visual visual-' + (i % 3 + 1) + (post.image ? ' with-photo' : '')}>
              {post.image && <img class="post-thumbnail" src={post.image} alt={post.imageAlt || post.title} loading="lazy" decoding="async" onerror="this.remove();this.parentElement.classList.remove('with-photo')" />}
              <div class="post-visual-fallback">
                <span>{post.category}</span>
                <strong>{post.title}</strong>
              </div>
            </div>
            <div class="post-content">
              <span class="post-category">{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="post-times" aria-label="Datas e horários">
                <span>Publicado no Radar: {post.publishedAt ? formatDateTime(post.publishedAt) : post.date}</span>
                <span>{post.sourcePublishedAt
                  ? 'Notícia publicada' + (post.sourceLabel ? ' pela ' + post.sourceLabel : '') + ': ' + formatDateTime(post.sourcePublishedAt)
                  : 'Artigo educativo'}</span>
              </div>
              <span class="post-foot"><span>{post.readingTime || 'Leitura breve'}</span><span class="read-more">Ler artigo ↗</span></span>
            </div>
          </a>
        )}
      </div>
      <p id="empty-state" class="empty-state" hidden>Nenhum artigo encontrado. Experimente outra palavra-chave.</p>
    </div>
  </section>

  <section class="about-section" id="sobre">
    <div class="container about-grid">
      <div>
        <span class="eyebrow light">POR TRÁS DO RADAR</span>
        <h2>Tecnologia e conhecimento para fortalecer a gestão sindical.</h2>
      </div>
      <div>
        <p>O Radar Sindical é uma iniciativa da Sindisoft, empresa especializada em soluções para sindicatos e entidades de classe. Nosso objetivo é transformar informação em conhecimento útil para a rotina de quem representa, administra e toma decisões.</p>
        <p>Da gestão financeira ao relacionamento com a categoria, aproximamos desafios reais de caminhos práticos para evoluir.</p>
        <a class="button button-primary" href="https://www.sindisoft.com.br/contato/" target="_blank" rel="noopener noreferrer">Falar com a Sindisoft <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const search = document.getElementById('search');
      const cards = Array.from(document.querySelectorAll('.post-card'));
      const counter = document.getElementById('count');
      const empty = document.getElementById('empty-state');
      const filters = Array.from(document.querySelectorAll('[data-editoria-filter]'));
      const valid = ['todos','noticias','gestao','tecnologia','sindisoft'];
      const initial = new URLSearchParams(window.location.search).get('categoria');
      let active = valid.includes(initial) ? initial : 'todos';
      if (!search) return;
      function render() {
        const query = search.value.trim().toLocaleLowerCase('pt-BR');
        let visible = 0;
        cards.forEach(card => {
          const matchesText = card.dataset.search.includes(query);
          const matchesCategory = active === 'todos' || card.dataset.editoria === active;
          const show = matchesText && matchesCategory;
          card.hidden = !show;
          if (show) visible++;
        });
        filters.forEach(button => {
          const selected = button.dataset.editoriaFilter === active;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        counter.textContent = visible + (visible === 1 ? ' conteúdo' : ' conteúdos');
        empty.hidden = visible !== 0;
      }
      search.addEventListener('input', render);
      filters.forEach(button => button.addEventListener('click', () => {
        active = button.dataset.editoriaFilter;
        const url = new URL(window.location.href);
        if (active === 'todos') url.searchParams.delete('categoria');
        else url.searchParams.set('categoria', active);
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        render();
      }));
      render();
    })();
  </script>
</BaseLayout>
