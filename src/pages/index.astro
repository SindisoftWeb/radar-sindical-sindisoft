---
import BaseLayout from '../layouts/BaseLayout.astro';
const modules = import.meta.glob('./artigos/*.md', { eager: true });
const posts = Object.values(modules)
  .map((entry: any) => ({ ...entry.frontmatter, url: entry.url }))
  .sort((a: any, b: any) => String(b.date).localeCompare(String(a.date)));
const featured = posts[0];
const formatDateTime = (value: any) => new Date(value).toLocaleString('pt-BR', {
  day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo'
});
const editorias = [
  { name: 'Gestão sindical', desc: 'Estratégia, organização e processos da entidade.' },
  { name: 'Convenções coletivas', desc: 'Acompanhamento, documentação e boas práticas.' },
  { name: 'Tecnologia e processos', desc: 'Transformação digital e eficiência operacional.' },
  { name: 'Comunicação com a categoria', desc: 'Relacionamento, informação e engajamento.' }
];
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-grid-pattern" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="pill">SINDISOFT / INTELIGÊNCIA SINDICAL</p>
        <h1 id="hero-heading">Informação para quem <em>faz a gestão acontecer.</em></h1>
        <p>Notícias, conhecimento e orientações práticas para quem lidera sindicatos, federações e entidades de classe.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#conteudos">Explorar conteúdos <span aria-hidden="true">→</span></a>
          <a class="simple-link" href="#sobre">Conheça o Radar <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-footnote">Conteúdo feito para transformar informação em decisões melhores.</p>
      </div>
      {featured && (
        <div class="hero-feature">
          <div class="feature-topbar">
            <span class="feature-topbar-left"><span class="feature-dot"></span> RADAR SINDICAL</span>
            <span class="feature-topbar-right">SINDISOFT / EDITORIAL</span>
          </div>
          <div class="feature-inner">
            <div class="feature-icon" aria-hidden="true"><span>◈</span><span class="feature-ring"></span></div>
            <p class="feature-eyebrow">CONTEÚDO EM DESTAQUE</p>
            <h2>{featured.title}</h2>
            <p>{featured.description}</p>
            <a href={featured.url} class="feature-link">Ler artigo completo <span aria-hidden="true">↗</span></a>
          </div>
          <div class="feature-bottom">
            <span>{featured.category}</span><span>Conhecimento em movimento ↗</span>
          </div>
        </div>
      )}
    </div>
    <div class="hero-scope">
      <div class="container">
        <span>Conhecimento para a rotina da sua entidade</span>
        <a href="#editorias">Gestão sindical</a>
        <a href="#editorias">Convenções coletivas</a>
        <a href="#editorias">Tecnologia e processos</a>
      </div>
    </div>
  </section>

  <section class="editorias-section" id="editorias">
    <div class="container">
      <div class="section-header">
        <div><span class="eyebrow">OS ASSUNTOS DO RADAR</span><h2>Conhecimento que acompanha a sua operação.</h2></div>
        <p>Um olhar sobre as decisões, os desafios e as oportunidades de quem trabalha com a representação de uma categoria.</p>
      </div>
      <div class="editorias-grid">
        {editorias.map((item, i) =>
          <a href="#conteudos" class="editoria-card">
            <span class="editoria-number">{String(i + 1).padStart(2, '0')}</span>
            <div class="editoria-detail"><h3>{item.name}</h3><p>{item.desc}</p></div>
            <span class="editoria-arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="conteudos-section" id="conteudos">
    <div class="container">
      <div class="section-header">
        <div><span class="eyebrow">BIBLIOTECA DE CONTEÚDOS</span><h2>Explore o Radar Sindical.</h2></div>
        <p>Artigos e orientações para apoiar uma gestão cada vez mais organizada, eficiente e conectada.</p>
      </div>
      <div class="filters">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Buscar por assunto ou palavra-chave..." aria-label="Buscar artigos" /></label>
        <span id="count" class="result-count">{posts.length} conteúdos</span>
      </div>
      <div class="posts-grid" id="posts-grid">
        {posts.map((post: any, i: number) =>
          <a class="post-card" href={post.url} data-search={(post.title + ' ' + post.description + ' ' + post.category).toLocaleLowerCase('pt-BR')}>
            <div class={'post-visual visual-' + (i % 3 + 1)}>
              <span class="visual-label">RADAR SINDICAL / {String(i + 1).padStart(2, '0')}</span>
              <div class="post-visual-art" aria-hidden="true"><span>◈</span><i></i><i></i></div>
              <span class="visual-word">SINDISOFT</span>
            </div>
            <div class="post-content">
              <span class="post-category">{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="post-times" aria-label="Datas e horários">
                <span>Publicado no Radar: {post.publishedAt ? formatDateTime(post.publishedAt) : post.date}</span>
                <span>{post.sourcePublishedAt
                  ? 'Notícia publicada' + (post.sourceLabel ? ' pela ' + post.sourceLabel : '') + ': ' + formatDateTime(post.sourcePublishedAt)
                  : 'Horário da fonte: não informado'}</span>
              </div>
              <span class="post-foot"><span>{post.readingTime || 'Leitura breve'}</span><span class="read-more">Ler artigo ↗</span></span>
            </div>
          </a>
        )}
      </div>
      <p id="empty-state" class="empty-state" hidden>Nenhum artigo encontrado. Experimente outra palavra-chave.</p>
    </div>
  </section>

  <section class="about-section" id="sobre">
    <div class="container about-grid">
      <div>
        <span class="eyebrow light">POR TRÁS DO RADAR</span>
        <h2>Tecnologia e conhecimento para fortalecer a gestão sindical.</h2>
      </div>
      <div>
        <p>O Radar Sindical é uma iniciativa da Sindisoft, empresa especializada em soluções para sindicatos e entidades de classe. Nosso objetivo é transformar informação em conhecimento útil para a rotina de quem representa, administra e toma decisões.</p>
        <p>Da gestão financeira ao relacionamento com a categoria, aproximamos desafios reais de caminhos práticos para evoluir.</p>
        <a class="button button-primary" href="https://www.sindisoft.com.br/contato/" target="_blank" rel="noopener noreferrer">Falar com a Sindisoft <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const search = document.getElementById('search');
      const cards = Array.from(document.querySelectorAll('.post-card'));
      const counter = document.getElementById('count');
      const empty = document.getElementById('empty-state');
      if (!search) return;
      search.addEventListener('input', () => {
        const query = search.value.trim().toLocaleLowerCase('pt-BR');
        let visible = 0;
        cards.forEach(card => {
          const show = card.dataset.search.includes(query);
          card.hidden = !show;
          if (show) visible++;
        });
        counter.textContent = visible + (visible === 1 ? ' conteúdo' : ' conteúdos');
        empty.hidden = visible !== 0;
      });
    })();
  </script>
</BaseLayout>
