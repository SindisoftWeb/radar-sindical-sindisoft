---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const otherArticles = Object.values(import.meta.glob('../pages/artigos/*.md', { eager: true })) as any[];
const related = otherArticles
  .filter(entry => entry.url !== Astro.url.pathname && entry.frontmatter?.category === frontmatter.category)
  .slice(0, 3)
  .map(entry => ({title: entry.frontmatter.title, url: entry.url}));
const category = String(frontmatter.category || '').toLocaleLowerCase('pt-BR');
const solutionText = category.includes('financeiro') || category.includes('arrecadação')
  ? 'A Sindisoft apresenta soluções de gestão financeira e arrecadação para apoiar a organização dos processos da entidade.'
  : category.includes('tecnologia') || category.includes('sindisoft')
    ? 'Conheça os recursos de gestão, arrecadação, comunicação, site e aplicativo apresentados oficialmente pela Sindisoft.'
    : 'Conheça a plataforma Sindisoft e suas soluções para organizar processos, informações e rotinas de entidades sindicais.';
const displayDate = frontmatter.date
  ? new Date(frontmatter.date + 'T12:00:00').toLocaleDateString('pt-BR', {day:'2-digit',month:'long',year:'numeric'})
  : '';
---
<BaseLayout title={frontmatter.title + ' | Radar Sindical'} description={frontmatter.description} image={frontmatter.image}>
  <section class="article-hero">
    <div class="container">
      <a class="back-link" href="/#conteudos">← Todos os conteúdos</a>
      <div class="article-intro">
        <span class="eyebrow">{frontmatter.category || 'Gestão sindical'}</span>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="article-meta"><span>Radar Sindical · Sindisoft</span>{displayDate && <span>{displayDate}</span>}{frontmatter.readingTime && <span>{frontmatter.readingTime} de leitura</span>}</div>
      </div>
    </div>
  </section>
  <section class="container article-shell">
    <article class="prose">
      {frontmatter.image && <figure class="article-cover">
        <img src={frontmatter.image} alt={frontmatter.imageAlt || frontmatter.title} decoding="async" loading="eager" onerror="this.closest('figure').remove()" />
        {frontmatter.imageCredit && <figcaption>
          Imagem: {frontmatter.imageSourceUrl
            ? <a href={frontmatter.imageSourceUrl} target="_blank" rel="noopener noreferrer">{frontmatter.imageCredit}</a>
            : frontmatter.imageCredit}
        </figcaption>}
      </figure>}
      <slot />
      {related.length > 0 && <section class="article-related" aria-label="Artigos relacionados">
        <h2>Leia também</h2>
        <ul>{related.map(item => <li><a href={item.url}>{item.title}</a></li>)}</ul>
      </section>}
    </article>
    <aside class="article-aside">
      <div class="aside-card">
        <span class="eyebrow">SINDISOFT NA PRÁTICA</span>
        <h2>Como a Sindisoft pode ajudar?</h2>
        <p>{solutionText}</p>
        <a class="button button-dark" href="https://www.sindisoft.com.br/" target="_blank" rel="noopener noreferrer">Conhecer soluções ↗</a>
      </div>
      <div class="aside-note">Este conteúdo tem finalidade informativa. Consulte a legislação aplicável e profissionais especializados antes de tomar decisões jurídicas ou financeiras.</div>
    </aside>
  </section>
</BaseLayout>
