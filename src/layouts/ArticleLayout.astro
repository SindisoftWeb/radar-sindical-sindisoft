---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const displayDate = frontmatter.date
  ? new Date(frontmatter.date + 'T12:00:00').toLocaleDateString('pt-BR', {day:'2-digit',month:'long',year:'numeric'})
  : '';
---
<BaseLayout title={frontmatter.title + ' | Radar Sindical'} description={frontmatter.description}>
  <section class="article-hero">
    <div class="container">
      <a class="back-link" href="/#conteudos">← Todos os conteúdos</a>
      <div class="article-intro">
        <span class="eyebrow">{frontmatter.category || 'Gestão sindical'}</span>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="article-meta"><span>Radar Sindical · Sindisoft</span>{displayDate && <span>{displayDate}</span>}{frontmatter.readingTime && <span>{frontmatter.readingTime} de leitura</span>}</div>
      </div>
    </div>
  </section>
  <section class="container article-shell">
    <article class="prose"><slot /></article>
    <aside class="article-aside">
      <div class="aside-card">
        <span class="eyebrow">TECNOLOGIA PARA ENTIDADES</span>
        <h2>Gestão que continua. Processos que funcionam.</h2>
        <p>Conheça como a Sindisoft pode apoiar a organização de processos, informações e relacionamentos com a categoria.</p>
        <a class="button button-dark" href="https://sindisoft.com.br/" target="_blank" rel="noopener noreferrer">Conhecer a Sindisoft ↗</a>
      </div>
      <div class="aside-note">Este conteúdo tem finalidade informativa. Consulte a legislação aplicável e profissionais especializados antes de tomar decisões jurídicas ou financeiras.</div>
    </aside>
  </section>
</BaseLayout>
