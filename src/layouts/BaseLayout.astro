---
import '../styles/site.css';
import '../styles/brand.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Radar Sindical | Sindisoft',
  description = 'Informação e orientações práticas sobre gestão sindical, tecnologia e relacionamento com a categoria.'
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#021226" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Radar Sindical — Sindisoft" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="identity" href="/" aria-label="Radar Sindical por Sindisoft — início">
          <img src="/sindisoft-logo.svg" alt="Sindisoft" width="164" height="41" class="official-logo" />
          <span class="identity-divider" aria-hidden="true"></span>
          <span class="identity-words"><strong>RADAR SINDICAL</strong><small>CONTEÚDO &amp; INTELIGÊNCIA</small></span>
        </a>
        <nav class="header-nav" aria-label="Navegação do Radar Sindical">
          <a href="/#conteudos">Conteúdos</a>
          <a href="/#editorias">Editorias</a>
          <a href="/#sobre">Sobre o Radar</a>
          <a href="https://www.sindisoft.com.br/" target="_blank" rel="noopener noreferrer">Site Sindisoft ↗</a>
          <a href="https://www.sindisoft.com.br/contato/" class="nav-cta" target="_blank" rel="noopener noreferrer">Solicitar demonstração <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-brand">
          <img src="/sindisoft-logo.svg" alt="Sindisoft" width="185" height="45" loading="lazy" />
          <span>RADAR SINDICAL</span>
          <p>Informação que fortalece a gestão.</p>
        </div>
        <div class="footer-about">
          <strong>Uma iniciativa da Sindisoft</strong>
          <p>Conhecimento e tecnologia para sindicatos, federações, confederações e associações de classe.</p>
        </div>
        <nav class="footer-links" aria-label="Links institucionais">
          <a href="/#conteudos">Artigos e guias</a>
          <a href="/#editorias">Editorias</a>
          <a href="https://www.sindisoft.com.br/" target="_blank" rel="noopener noreferrer">Sindisoft ↗</a>
          <a href="https://www.instagram.com/sindisoftbr/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        </nav>
      </div>
      <div class="container footer-fine">
        <span>© {new Date().getFullYear()} Sindisoft · Radar Sindical</span>
        <span>Conteúdo informativo. Consulte fontes oficiais e orientação profissional para decisões jurídicas ou financeiras.</span>
      </div>
    </footer>
  </body>
</html>
